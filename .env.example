# Copy to .env and fill in values before running docker-compose up

# PostgreSQL
POSTGRES_DB=itam
POSTGRES_USER=itam
POSTGRES_PASSWORD=changeme_strong_password_here

# Kafka KRaft cluster ID (generate once: kafka-storage random-uuid)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# JWT signing secret (min 32 chars)
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long

# Enrollment HMAC secret (min 32 chars)
ENROLLMENT_SECRET=changeme_enrollment_hmac_secret_32_chars

# Static bearer token for admin API endpoints
ADMIN_TOKEN=changeme_admin_api_token_here
